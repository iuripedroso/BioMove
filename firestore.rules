rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só pode ler/escrever o próprio documento de perfil
    // (users/{uid}) e a própria subcoleção de testes recentes
    // (users/{uid}/recentTests/*). Ninguém enxerga dados de outro usuário.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /recentTests/{testId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
